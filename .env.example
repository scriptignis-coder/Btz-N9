# Copy this file to .env.local for local development (vercel dev).
# In Vercel: Project -> Settings -> Environment Variables, add each one there
# (the database and blob variables below are usually added FOR YOU automatically
# when you attach a Postgres/Neon database and a Blob store to the project).

# Postgres connection string (added automatically when you connect a Neon/Postgres
# database to the project in Vercel -> Storage).
DATABASE_URL=

# Vercel Blob read/write token (added automatically when you create a Blob store
# in Vercel -> Storage and connect it to the project).
BLOB_READ_WRITE_TOKEN=

# The single admin login. Pick your own values — this is not an email, just a
# username you choose.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Any long random string, used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
