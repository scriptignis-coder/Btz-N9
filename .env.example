# Copy this file to .env for local development.
# In Render: your web service -> Environment -> add each one there.

# Postgres connection string from neon.tech (free, standalone — sign up at
# neon.tech, create a project, copy the connection string it gives you).
DATABASE_URL=

# From cloudinary.com (free tier) -> Dashboard -> these three values are shown
# right at the top ("Product Environment Credentials").
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The single admin login. Pick your own values — this is not an email, just a
# username you choose.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Any long random string, used to sign the admin session cookie.
# Generate one at https://generate-secret.vercel.app/32 or any password generator.
SESSION_SECRET=
